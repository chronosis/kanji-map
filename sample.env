# Copy to .env and fill in values. Never commit .env.

# WaniKani API token (Account Settings → API Tokens)
WANIKANI_API_KEY=

# BunPro frontend_api_token — cookie from bunpro.jp (DevTools → Application → Cookies).
# Often a 32-char hex string (not always a JWT). Do NOT use the Account Settings "API key".
# Env name kept for compatibility; value is the frontend cookie, whatever format BunPro issues.
BUNPRO_FRONTEND_JWT=

# SQLite database file path (relative to project root or absolute)
DATABASE_PATH=./data/kanji-map.sqlite
